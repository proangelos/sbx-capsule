# Sandbox tooling config. Copy to .env (gitignored) and fill in your own
# repos -- nothing is defined by default, and the tool won't run without it:
#
#   make init        (or: cp .env.example .env)
#
# The tool reads .env.default (its tracked defaults) first, then this file.
#
# This is a plain bash file (associative arrays), not dotenv KEY=VALUE
# syntax. Repo names are your own short keys: letters, digits, '.', '_' and
# '-' only. Every make command checks this file and lists all problems it
# finds before doing anything.

# REQUIRED. Each repo's local source checkout. Sandboxes clone from here
# (fetching its `origin/*` branches, so no git objects are shared with it),
# then fetch from that checkout's `origin`.
declare -A REPOS=(
  [api]="$HOME/dev/api"
  [web]="$HOME/dev/web"
  [worker]="$HOME/dev/worker"
)

# REQUIRED for every repo in REPOS. The branch a sandbox starts from, fetched
# fresh from origin. Override it per sandbox with WITH="repo:branch" (below).
declare -A SOURCE_BRANCHES=(
  [api]="main"
  [web]="main"
  [worker]="develop"
)

# OPTIONAL. Repos included in every `make new`, created after the ones named
# in WITH. Empty means a sandbox gets only what WITH names. Naming a default
# repo in WITH too is fine: WITH's branch (if any) wins. `make new EMPTY=1`
# skips these, for a sandbox that starts with no repos.
DEFAULT_REPOS=()
# DEFAULT_REPOS=(api web)

# OPTIONAL. Only used to group and describe repos in each sandbox's
# generated README.md.
declare -A REPO_GROUP=(
  [api]="web app"
  [web]="web app"
)
declare -A REPO_DESC=(
  [api]="backend API"
  [web]="frontend, talks to api"
  [worker]="background job runner"
)

# ---- OPTIONAL: override the tool's defaults ----
# .env.default (tracked) is read before this file and sets AGENT="claude",
# no AGENT_ARGS (each agent uses its own default model), no extra
# SBX_CREATE_FLAGS, no SBX_NAME_PREFIX, AGENT_GIT_PUSH="no" and no
# SANDBOX_NOTES_FILE. See that
# file for what each does; set any of them here to change it for you.
# AGENT="codex"
# AGENT_ARGS[claude]="--model opus"      # one entry; keeps any others
# SBX_CREATE_FLAGS="--cpus 8 --memory 8g"
# SBX_NAME_PREFIX="sbx"                  # VMs named sbx-<checkout id>-<sandbox>
# AGENT_GIT_PUSH="yes"
# SANDBOX_NOTES_FILE="$HOME/dev/sandbox-team-notes.md"
#
# make code (VS Code inside the sandbox's VM): .env.default finds VS Code
# and uses its default profile. Override if you use a separate profile for
# sandboxes, Insiders or Cursor, or a non-standard settings folder:
# VSCODE_PROFILE="sbx"
# VSCODE_CMD="cursor"
# VSCODE_USER_DIR="$HOME/.config/Cursor/User"

# Usage, for reference:
#   make new WITH="api web:feat/new-login" PUSH_AS=feat/new-login
#     api starts from SOURCE_BRANCHES[api]; web starts from feat/new-login
#     (on origin, or a local-only branch in the source checkout).
#   make add N=3 REPO="worker:fix/retry"
