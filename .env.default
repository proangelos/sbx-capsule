# Tool defaults, read before your .env. Don't edit this file: override any
# setting in your .env instead (see .env.example). Plain bash, like .env.
# Repos aren't defined here -- they're yours to define in .env.

# The coding agent `make run` starts in a new sandbox VM: one of sbx's
# built-in agents -- claude codex copilot cursor devin docker-agent droid
# gemini kiro opencode shell -- an sbx kit reference (./path, git URL,
# OCI ref), or a profile in user-config/agents/<name>.env. A VM keeps the
# agent it was created with; changing this only affects new VMs. A sandbox
# given its own agent (make new/run AGENT=<name>) ignores this setting. Each agent needs signing in once (see README.md,
# "Choosing an agent"): claude with /login inside a VM; most others with
# `sbx secret set <service>` (openai for codex, google for gemini, ...).
AGENT="claude"

# Default arguments per agent, passed on every `make run` (create and
# reattach) before any ARGS="..." given on the command line. Keys are
# built-in agent names or kit references; a profile has its own ARGS. Empty: each agent runs with its own defaults,
# including its default model. In .env, set one entry without replacing the
# rest: AGENT_ARGS[claude]="--model opus"
declare -A AGENT_ARGS=()

# Extra `sbx run` flags, used only when a VM is created. Flags only, each
# value after its flag: anything sbx accepts except --name, --clone,
# --cloud, --detach and --rm, which this tool manages, and --mount and
# --skills readwrite, which reach into the host. Examples: "--cpus 8 --memory 8g", "-t my-template",
# "--kit ./my-mixin", "-p 3000", "--env-file $HOME/.sandbox-env". Relative
# --kit, --kit-args-file and --env-file paths are taken from the tool's
# folder, and none may be inside a sandbox folder. A profile's CREATE_FLAGS
# come after these.
SBX_CREATE_FLAGS=""

# A prefix for the names of the sbx VMs `make run` creates. Names are
# "<checkout id>-<sandbox folder>" (e.g. 4f0c2a-3-login-fix), or
# "<prefix>-<checkout id>-<sandbox folder>" with a prefix. The checkout id
# always stays, so two checkouts of this tool never share a VM. Lowercase
# letters, digits and '-' (not at either end); empty for no prefix. Changing
# it only names new VMs: existing ones keep their names and still work, and
# `make run N=<n> FRESH=1` recreates one under the new name.
SBX_NAME_PREFIX=""

# May the agent push? "no": it commits, and you push from the host. "yes":
# it may push its own branch -- your git host must be on the sbx network
# allow-list and credentials set up (see README.md, "Letting the agent push").
AGENT_GIT_PUSH="no"

# Your own instructions for the agent, one plain-text string each. They're
# written near the top of every new sandbox's AGENTS.md, under "User
# instructions", which tells the agent they take priority over the tool's
# generated rules. The tool says nothing about committing, so say here
# whether the agent should commit on its own or wait for you (see
# .env.example). Copied when a sandbox is created; editing this later
# doesn't change existing sandboxes. Empty for none.
AGENT_INSTRUCTIONS=()

# A markdown file copied into every new sandbox's AGENTS.md under "Team
# notes": how your repos relate, local stacks the agent shouldn't touch,
# conventions. Empty for none.
SANDBOX_NOTES_FILE=""

# `make code`: opens a sandbox in VS Code running inside its VM (see
# README.md, "Reviewing and editing a sandbox"). All three are optional.
# VSCODE_CMD: the command that opens VS Code; empty finds it (on WSL,
# Windows' VS Code; elsewhere `code`). Set it for Insiders or Cursor, e.g.
# "code-insiders" or "cursor".
VSCODE_CMD=""
# VSCODE_PROFILE: open sandboxes in this VS Code profile; empty uses the
# default profile.
VSCODE_PROFILE=""
# VSCODE_USER_DIR: the folder holding your VS Code user settings.json, which
# make doctor and make code check; empty finds the standard one.
VSCODE_USER_DIR=""
